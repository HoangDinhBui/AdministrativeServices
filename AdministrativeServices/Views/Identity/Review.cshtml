@model AdministrativeServices.Models.IdentityVerificationRequest
@using AdministrativeServices.Models

@{
    ViewData["Title"] = "Duyệt yêu cầu xác thực";
    var citizen = ViewBag.Citizen as Citizen;
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <a asp-action="Manage" class="btn btn-outline-secondary mb-3"><i class="bi bi-arrow-left"></i> Quay lại</a>
            <h2 class="text-white">Duyệt yêu cầu: @Model.User?.Email</h2>
        </div>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    <div class="row">
        <!-- User Submitted Data -->
        <div class="col-md-6">
            <div class="glass-card h-100">
                <h4 class="text-info mb-3">Thông tin người dùng gửi</h4>
                <div class="mb-3">
                    <label class="fw-bold">Số CCCD khai báo:</label>
                    <div class="fs-4">@Model.CCCD</div>
                </div>
                
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="fw-bold d-block mb-2">Mặt trước:</label>
                        <img src="@Model.FrontImage" class="img-fluid rounded border bg-light" style="max-height: 200px;" onclick="window.open(this.src, '_blank')" role="button" title="Click để xem ảnh lớn" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="fw-bold d-block mb-2">Mặt sau:</label>
                        <img src="@Model.BackImage" class="img-fluid rounded border bg-light" style="max-height: 200px;" onclick="window.open(this.src, '_blank')" role="button" title="Click để xem ảnh lớn" />
                    </div>
                    <div class="col-md-12 mb-3 text-center">
                        <label class="fw-bold d-block mb-2">Chân dung:</label>
                         <img src="@Model.PortraitImage" class="img-fluid rounded border bg-light" style="max-height: 200px;" onclick="window.open(this.src, '_blank')" role="button" title="Click để xem ảnh lớn" />
                    </div>
                </div>
            </div>
        </div>

        <!-- Database Match -->
        <div class="col-md-6">
            <div class="glass-card h-100 bg-opacity-10 @(citizen != null ? "bg-success" : "bg-danger")">
                <h4 class="text-white mb-3">
                     Dữ liệu Quốc gia (Công an)
                     @if(citizen != null) { <span class="badge bg-success float-end">Đã tìm thấy</span> }
                     else { <span class="badge bg-danger float-end">Không tìm thấy</span> }
                </h4>
                
                @if (citizen != null)
                {
                    <dl class="row">
                        <dt class="col-sm-4">Họ và tên:</dt>
                        <dd class="col-sm-8 fw-bold">@citizen.FullName</dd>

                        <dt class="col-sm-4">Ngày sinh:</dt>
                        <dd class="col-sm-8">@citizen.DateOfBirth.ToString("dd/MM/yyyy")</dd>

                        <dt class="col-sm-4">Giới tính:</dt>
                        <dd class="col-sm-8">@citizen.Gender</dd>

                        <dt class="col-sm-4">Quê quán:</dt>
                        <dd class="col-sm-8">@citizen.Hometown</dd>

                        <dt class="col-sm-4">Thường trú:</dt>
                        <dd class="col-sm-8">@citizen.PermanentAddress</dd>
                    </dl>
                    
                     <div class="alert alert-warning mt-3">
                        <i class="bi bi-exclamation-triangle-fill"></i> Kiểm tra kỹ hình ảnh CCCD và ảnh chân dung so với thông tin này.
                    </div>
                }
                else
                {
                    <div class="alert alert-danger">
                        Không tìm thấy công dân nào có số CCCD <strong>@Model.CCCD</strong> trong hệ thống cơ sở dữ liệu quốc gia.
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Actions -->
    <div class="row mt-4 mb-5">
        <div class="col-12 text-center">
            @if (citizen != null)
            {
                <form asp-action="Approve" asp-route-id="@Model.Id" method="post" class="d-inline-block me-3">
                    <button type="submit" class="btn btn-success btn-lg px-5" onclick="return confirm('Bạn có chắc chắn muốn phê duyệt yêu cầu này? Tài khoản sẽ được liên kết với công dân @citizen.FullName.')">
                        <i class="bi bi-check-lg"></i> PHÊ DUYỆT
                    </button>
                </form>
            }
            
            <button type="button" class="btn btn-danger btn-lg px-5" data-bs-toggle="modal" data-bs-target="#rejectModal">
                <i class="bi bi-x-lg"></i> TỪ CHỐI
            </button>
        </div>
    </div>
</div>

<!-- Reject Modal -->
<div class="modal fade" id="rejectModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content text-dark">
            <div class="modal-header">
                <h5 class="modal-title">Từ chối yêu cầu</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="Reject" asp-route-id="@Model.Id" method="post">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Lý do từ chối:</label>
                        <textarea name="reason" class="form-control" rows="3" required placeholder="Ví dụ: Ảnh mờ, CCCD không khớp..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-danger">Xác nhận từ chối</button>
                </div>
            </form>
        </div>
    </div>
</div>
