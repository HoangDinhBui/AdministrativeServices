@{
    ViewData["Title"] = "Từ chối truy cập";
}

<div class="container mt-5">
    <div class="glass-card text-center p-5">
        <div class="mb-4">
            <i class="bi bi-shield-lock-fill text-danger" style="font-size: 5rem;"></i>
        </div>
        <h1 class="text-danger fw-bold mb-3">403 - Từ chối truy cập</h1>
        <p class="lead mb-4">Xin lỗi, bạn không có quyền truy cập vào trang này.</p>
        <p class="text-muted mb-5">
            Nếu bạn cho rằng đây là một lỗi, vui lòng liên hệ với quản trị viên hoặc quay lại trang chủ.
        </p>
        <div>
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary btn-lg px-4">
                <i class="bi bi-house-fill me-2"></i> Quay lại trang chủ
            </a>
            <a asp-controller="Account" asp-action="Login" class="btn btn-outline-secondary btn-lg px-4 ms-2">
                <i class="bi bi-box-arrow-in-right me-2"></i> Đăng nhập lại
            </a>
        </div>
    </div>
</div>
