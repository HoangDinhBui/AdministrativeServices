@{
    ViewData["Title"] = "Đăng nhập";
}

<div class="glass-card auth-container">
    <h2 class="text-center mb-4">Chào mừng trở lại</h2>
    <form asp-action="Login" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        
        <div class="mb-3">
            <label class="form-label fw-bold">Số CCCD hoặc Email (Cán bộ)</label>
            <input name="cccd" class="form-control" placeholder="Nhập số CCCD hoặc Email" required />
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">Mật khẩu</label>
            <input name="password" type="password" class="form-control" placeholder="••••••••" required />
            <div class="form-text text-end"><a href="#" class="text-decoration-none text-muted small">Quên mật khẩu?</a></div>
        </div>

        <div class="mb-3 form-check">
            <input type="checkbox" name="rememberMe" class="form-check-input" id="rememberMe">
            <label class="form-check-label" for="rememberMe">Ghi nhớ đăng nhập</label>
        </div>

        <button type="submit" class="btn btn-primary w-100 mt-2">Đăng nhập</button>
        
        <div class="text-center mt-4">
            <span>Chưa có tài khoản? </span>
            <a asp-action="Register" class="text-decoration-none">Đăng ký mới</a>
        </div>
    </form>
</div>
