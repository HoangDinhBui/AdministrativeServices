@{
    ViewData["Title"] = "Trang chủ";
}

<div class="container py-5">

    <!-- HERO -->
    <div class="row align-items-center mb-5">
        <div class="col-lg-6">
            <h1 class="hero-title mb-3"
                style="font-family:'Be Vietnam Pro', Inter, system-ui, sans-serif; font-weight:800; letter-spacing:0.4px;">
                Giải quyết thủ tục
                <br />
                <span class="text-gradient">nhanh – gọn – minh bạch</span>
            </h1>

            <p class="hero-desc mb-4">
                Nền tảng dịch vụ công trực tuyến giúp công dân thực hiện
                thủ tục hành chính mọi lúc, mọi nơi.
            </p>

            @if (User.Identity?.IsAuthenticated != true)
            {
                <div class="d-flex gap-3 hero-actions">
                    <a asp-controller="Account" asp-action="Register" class="btn btn-gradient-modern btn-lg px-4">
                        Bắt đầu ngay
                    </a>

                    <a asp-controller="Account" asp-action="Login" class="btn btn-outline-modern btn-lg px-4">
                        Đăng nhập
                    </a>
                </div>
            }
        </div>

        <div class="col-lg-6 mt-4 mt-lg-0">
            <div class="hero-image"></div>
        </div>

    </div>

    <!-- SERVICES -->
    <h3 class="fw-bold mb-4">Dịch vụ nổi bật</h3>

    <div class="row g-4">
        <div class="col-12 col-md-6">
            <div class="service-card">
                <i class="bi bi-house-door-fill"></i>
                <h5>Đăng ký thường trú</h5>
                <p>
                    Đăng ký thường trú hoặc thành lập hộ gia đình mới
                    theo quy định.
                </p>
                <a asp-controller="Citizen" asp-action="CreateResidentRegistration">
                    Thực hiện <span>→</span>
                </a>
            </div>
        </div>

        <div class="col-12 col-md-6">
            <div class="service-card">
                <i class="bi bi-person-plus-fill"></i>
                <h5>Đăng ký khai sinh</h5>
                <p>
                    Dịch vụ liên thông khai sinh, BHYT
                    và đăng ký thường trú cho trẻ.
                </p>
                <a asp-controller="BirthRegistration" asp-action="Create">
                    Thực hiện <span>→</span>
                </a>
            </div>
        </div>

        <div class="col-12 col-md-6">
            <div class="service-card">
                <i class="bi bi-heart-fill"></i>
                <h5>Đăng ký kết hôn</h5>
                <p>
                    Thực hiện thủ tục đăng ký kết hôn
                    trực tuyến cho công dân Việt Nam.
                </p>
                <a asp-controller="MarriageRegistration" asp-action="Create">
                    Thực hiện <span>→</span>
                </a>
            </div>
        </div>

        <div class="col-12 col-md-6">
            <div class="service-card">
                <i class="bi bi-geo-alt-fill"></i>
                <h5>Đăng ký tạm trú</h5>
                <p>
                    Đăng ký tạm trú khi cư trú
                    ngoài địa bàn thường trú.
                </p>
                <a asp-controller="TemporaryResidence" asp-action="Create">
                    Thực hiện <span>→</span>
                </a>
            </div>
        </div>
    </div>
</div>



<style>
    .transition-hover:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
    }
</style>