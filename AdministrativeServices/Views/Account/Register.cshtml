@{
    ViewData["Title"] = "Đăng ký tài khoản";
}

<div class="glass-card auth-container">
    <h2 class="text-center mb-4">Đăng ký tài khoản VNeID</h2>
    <form asp-action="Register" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        
        <div class="mb-3">
            <label class="form-label fw-bold">Số Căn cước công dân (CCCD)</label>
            <input name="cccd" class="form-control" placeholder="Nhập 12 số CCCD" required pattern="[0-9]{12}" />
            <div class="form-text">Nhập đúng số CCCD gắn chip của bạn.</div>
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">Số điện thoại</label>
            <input name="phoneNumber" type="tel" class="form-control" placeholder="Nhập số điện thoại" required pattern="[0-9]{10}" />
        </div>

        <button type="submit" class="btn btn-primary w-100 mt-3">
            Tiếp tục <i class="bi bi-arrow-right"></i>
        </button>
        
        <div class="text-center mt-4">
            <span>Đã có tài khoản? </span>
            <a asp-action="Login" class="text-decoration-none">Đăng nhập ngay</a>
        </div>
    </form>
</div>
