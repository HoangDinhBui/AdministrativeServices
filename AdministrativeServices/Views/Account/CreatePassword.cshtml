@{
    ViewData["Title"] = "Tạo mật khẩu";
}

<div class="glass-card auth-container">
    <h2 class="text-center mb-4">Tạo mật khẩu</h2>
    <div class="alert alert-success border-0 bg-success bg-opacity-10 text-center">
        <i class="bi bi-check-circle-fill me-2"></i>Xác thực OTP thành công!
    </div>
    <p class="text-center text-muted mb-4">
        Tài khoản CCCD: <strong>@ViewBag.CCCD</strong><br/>
        Vui lòng tạo mật khẩu để hoàn tất đăng ký.
    </p>

    <form asp-action="CreatePassword" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        
        <div class="mb-3">
            <label class="form-label fw-bold">Mật khẩu mới</label>
            <input type="password" name="password" class="form-control" placeholder="Nhập mật khẩu (tối thiểu 6 ký tự)" required minlength="6" autofocus />
            <div class="form-text">Mật khẩu phải có ít nhất 6 ký tự, bao gồm chữ hoa, chữ thường và số.</div>
        </div>

        <div class="mb-4">
            <label class="form-label fw-bold">Xác nhận mật khẩu</label>
            <input type="password" name="confirmPassword" class="form-control" placeholder="Nhập lại mật khẩu" required minlength="6" />
        </div>

        <button type="submit" class="btn btn-primary w-100 mb-3">Hoàn tất đăng ký</button>
        
        <div class="text-center">
            <a asp-action="Register" class="text-decoration-none">Quay lại đăng ký</a>
        </div>
    </form>
</div>
